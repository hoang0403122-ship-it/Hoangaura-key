<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoidShell - Key Result</title>
    <style>
        body {
            margin: 0; height: 100vh; display: flex; justify-content: center; align-items: center;
            font-family: 'Segoe UI', sans-serif;
            background: url('https://i.pinimg.com/originals/8a/8d/30/8a8d30e4c62b9044f507b5a839f8f2b1.gif') no-repeat center center fixed;
            background-size: cover; color: #fff; position: relative;
        }
        body::before { content: ''; position: absolute; top:0; left:0; width:100%; height:100%; background: rgba(10,10,20,0.75); backdrop-filter: blur(8px); z-index: 1; }
        .box { position: relative; z-index: 2; background: rgba(20,22,37,0.9); padding: 30px; border-radius: 20px; text-align: center; width: 320px; border: 1px solid rgba(245, 158, 11, 0.4); box-shadow: 0 15px 35px rgba(0,0,0,0.8); }
        h3 { color: #f59e0b; margin-top: 0; text-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
        .key-box { background: #0f1117; padding: 12px; border-radius: 10px; font-weight: bold; color: #34d399; margin: 15px 0; word-break: break-all; border: 1px dashed #f59e0b; }
        .copy-btn { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none; padding: 12px; border-radius: 10px; font-weight: bold; cursor: pointer; width: 100%; transition: 0.2s; }
        .copy-btn:hover { filter: brightness(1.2); transform: scale(1.02); }
    </style>
</head>
<body>
    <div class="box">
        <h3>🎉 VoidShell Key</h3>
        <div class="key-box" id="keyDisplay">Đang tạo...</div>
        <button class="copy-btn" onclick="copyKey()">📋 Copy Key Ngay</button>
    </div>
    <script>
        function getKey() {
            const d = new Date();
            return `VOID-${d.getFullYear()}${d.getMonth()+1}${d.getDate()}-${d.getHours() < 12 ? 'P1' : 'P2'}`;
        }
        const k = getKey();
        document.getElementById('keyDisplay').innerText = k;
        function copyKey() { navigator.clipboard.writeText(k); alert('Đã copy Key VoidShell thành công!'); }
    </script>
</body>
</html>

